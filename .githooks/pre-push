#!/usr/bin/env bash
# Bloque un push GitHub de l'arbre privé (site, desktop, navin.live, AWS).
# Le seul push autorisé vers navin / navin-agi passe par scripts/publish-git.sh
# (NAVIN_PUBLIC_PUSH=1) avec l'arbre déjà filtré.
set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"

is_github_public=0
case "$remote_url" in
  *github.com/navinspire-ai/navin.git*|*github.com[:/]navinspire-ai/navin.git*)
    is_github_public=1 ;;
  *github.com/navinspire-ai/navin-agi.git*|*github.com[:/]navinspire-ai/navin-agi.git*)
    is_github_public=1 ;;
esac
case "$remote_name" in
  github|origin) is_github_public=1 ;;
esac

if [ "$is_github_public" -ne 1 ]; then
  exit 0
fi

if [ "${NAVIN_PUBLIC_PUSH:-}" != "1" ]; then
  echo "pre-push: refus vers GitHub (arbre privé)." >&2
  echo "Utilise : scripts/publish-git.sh github" >&2
  echo "(dry-run : scripts/publish-git.sh github --dry-run)" >&2
  exit 1
fi

private_re='^(site/|src/|desktop/|desktop-electron/|os/|templates/|tmp-preview-fixture/|deploy/docker/site|packaging/aws/|packaging/linux/|packaging/macos/|packaging/windows/|navin/license_client\.py|navin/license_sync\.py|navin/webui/account_api\.py|scripts/publish-os-to-s3\.sh|scripts/publish-templates-to-s3\.sh|scripts/publish-media-templates-to-s3\.sh|scripts/s3-bucket-policy\.json)'

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  leaked="$(git ls-tree -r --name-only "$local_sha" | grep -E "$private_re" || true)"
  if [ -n "$leaked" ]; then
    echo "pre-push: l'arbre poussé vers GitHub contient encore des chemins privés :" >&2
    echo "$leaked" | head -n 20 >&2
    exit 1
  fi
done
