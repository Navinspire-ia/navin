{
  "docs": [
    "Reasoning-effort catalog: which effort levels each model family accepts.",
    "This is DATA, not code - update this file when vendors ship new models;",
    "no Python change is needed. A user override placed next to config.json",
    "(~/.navin/reasoning_catalog.json) is merged in front of this file, so",
    "corrections can be applied without touching the installed package.",
    "",
    "Matching: families are evaluated in order; a family matches if ANY of its",
    "'match' conditions hit (contains_any / regex / provider_any are OR'ed).",
    "Inside a family, rules are evaluated in order and ALL fields of a rule",
    "must hold (contains_any = at least one substring, contains_all = every",
    "substring, excludes_any = none of the substrings, regex = search hit,",
    "provider_any = provider name is one of). First matching rule wins; if no",
    "rule matches, the family 'fallback' applies. The empty string value means",
    "'Default/Auto' (parameter omitted). If no family matches, callers fall",
    "back to default_values.",
    "Model names and providers are lowercased before matching."
  ],
  "version": "2026-07-25",
  "default_values": ["", "low", "medium", "high"],
  "families": [
    {
      "id": "anthropic-claude",
      "match": { "contains_any": ["claude"], "provider_any": ["anthropic"] },
      "rules": [
        {
          "note": "Opus 4.7/4.8, 5.x families, Fable, Mythos: output_config.effort full ladder + adaptive thinking.",
          "contains_any": ["opus-4-7", "opus-4-8", "opus-5", "sonnet-5", "haiku-5", "fable", "mythos"],
          "values": ["", "adaptive", "low", "medium", "high", "xhigh", "max"]
        },
        {
          "note": "Opus 4.6: effort up to max, adaptive thinking, no xhigh.",
          "contains_any": ["opus-4-6"],
          "values": ["", "adaptive", "low", "medium", "high", "max"]
        },
        {
          "note": "Sonnet 4.6: adaptive thinking, effort low..high.",
          "contains_any": ["sonnet-4-6"],
          "values": ["", "adaptive", "low", "medium", "high"]
        },
        {
          "note": "Claude 4.x and 3.7: extended thinking via budget_tokens (Opus 4.5 also effort beta).",
          "contains_any": [
            "opus-4-5", "sonnet-4-5", "haiku-4-5",
            "opus-4-1", "opus-4-0", "opus-4-2", "sonnet-4-0", "sonnet-4-2",
            "3-7-sonnet", "sonnet-3-7", "opus-4-20", "sonnet-4-20",
            "opus-4", "sonnet-4", "haiku-4"
          ],
          "values": ["", "low", "medium", "high"]
        }
      ],
      "fallback": [""]
    },
    {
      "id": "openai-gpt-5",
      "match": { "contains_any": ["gpt-5"] },
      "rules": [
        {
          "note": "Chat/search variants never expose reasoning control.",
          "contains_any": ["chat", "search"],
          "values": [""]
        },
        {
          "note": "GPT-5.6+ (Sol/Terra/Luna) pro mode: medium..max. (?!\\d) keeps dated snapshots like -2025- from matching as a minor version.",
          "regex": "gpt-5[.-]([6-9]|[1-9][0-9])(?!\\d)",
          "contains_any": ["pro"],
          "values": ["", "medium", "high", "xhigh", "max"]
        },
        {
          "note": "GPT-5.6+ standard: six-level ladder including the new max effort.",
          "regex": "gpt-5[.-]([6-9]|[1-9][0-9])(?!\\d)",
          "values": ["", "none", "low", "medium", "high", "xhigh", "max"]
        },
        {
          "note": "GPT-5.3 Codex .. GPT-5.5 codex variants.",
          "regex": "gpt-5[.-][3-5](?!\\d)",
          "contains_any": ["codex"],
          "values": ["", "low", "medium", "high", "xhigh"]
        },
        {
          "regex": "gpt-5[.-][3-5](?!\\d)",
          "contains_any": ["pro"],
          "values": ["", "medium", "high", "xhigh"]
        },
        {
          "note": "GPT-5.3..5.5 standard: xhigh available, no max.",
          "regex": "gpt-5[.-][3-5](?!\\d)",
          "values": ["", "none", "low", "medium", "high", "xhigh"]
        },
        {
          "regex": "gpt-5[.-]2(?!\\d)",
          "contains_any": ["pro"],
          "values": ["", "medium", "high", "xhigh"]
        },
        {
          "regex": "gpt-5[.-]2(?!\\d)",
          "contains_any": ["codex"],
          "values": ["", "low", "medium", "high", "xhigh"]
        },
        {
          "regex": "gpt-5[.-]2(?!\\d)",
          "values": ["", "none", "low", "medium", "high", "xhigh"]
        },
        {
          "regex": "gpt-5[.-]1(?!\\d)",
          "contains_any": ["codex-max"],
          "values": ["", "low", "medium", "high", "xhigh"]
        },
        {
          "regex": "gpt-5[.-]1(?!\\d)",
          "contains_any": ["codex"],
          "values": ["", "low", "medium", "high"]
        },
        {
          "regex": "gpt-5[.-]1(?!\\d)",
          "values": ["", "none", "low", "medium", "high"]
        },
        {
          "note": "Original GPT-5.",
          "contains_any": ["pro"],
          "values": ["", "high"]
        },
        {
          "contains_any": ["codex"],
          "values": ["", "low", "medium", "high"]
        }
      ],
      "fallback": ["", "minimal", "low", "medium", "high"]
    },
    {
      "id": "openai-o-series",
      "match": { "regex": "(^|[/\\-_])o[134](-|$|[.\\d])" },
      "rules": [],
      "fallback": ["", "low", "medium", "high"]
    },
    {
      "id": "openai-legacy",
      "match": { "contains_any": ["gpt-4", "gpt-3.5", "chatgpt"] },
      "rules": [],
      "fallback": [""]
    },
    {
      "id": "google-gemini",
      "match": { "contains_any": ["gemini"] },
      "rules": [
        {
          "note": "Gemini 3.x Flash / Flash-Lite: thinking_level minimal..high.",
          "contains_all": ["gemini-3"],
          "contains_any": ["flash", "lite"],
          "values": ["", "minimal", "low", "medium", "high"]
        },
        {
          "note": "Gemini 3.x Pro: thinking_level low..high, cannot disable.",
          "contains_any": ["gemini-3"],
          "values": ["", "low", "medium", "high"]
        },
        {
          "note": "Gemini 2.5 Pro cannot disable thinking.",
          "contains_any": ["gemini-2.5", "gemini-2-5"],
          "contains_all": ["pro"],
          "values": ["", "low", "medium", "high"]
        },
        {
          "note": "Gemini 2.5 Flash tiers can disable thinking.",
          "contains_any": ["gemini-2.5", "gemini-2-5"],
          "values": ["", "none", "low", "medium", "high"]
        }
      ],
      "fallback": [""]
    },
    {
      "id": "xai-grok",
      "match": { "contains_any": ["grok"] },
      "rules": [
        {
          "contains_any": ["multi-agent"],
          "values": ["", "low", "medium", "high", "xhigh"]
        },
        {
          "contains_any": ["grok-4.6", "grok-4-6"],
          "values": ["", "low", "medium", "high", "xhigh"]
        },
        {
          "contains_any": ["grok-4.5", "grok-4-5"],
          "values": ["", "low", "medium", "high"]
        },
        {
          "contains_any": ["grok-4.3", "grok-4-3"],
          "values": ["", "none", "low", "medium", "high"]
        },
        {
          "contains_any": ["grok-3-mini"],
          "values": ["", "low", "high"]
        }
      ],
      "fallback": [""]
    },
    {
      "id": "moonshot-kimi",
      "match": { "contains_any": ["kimi"] },
      "rules": [
        {
          "contains_any": ["k3"],
          "values": ["", "low", "high", "max"]
        },
        {
          "note": "Always-thinking models: no level control.",
          "contains_any": ["k2.7-code", "k2-7-code", "k2-thinking", "k2.7", "k2-7"],
          "values": [""]
        },
        {
          "note": "Thinking on/off toggle.",
          "contains_any": ["k2.5", "k2-5", "k2.6", "k2-6"],
          "values": ["", "none", "high"]
        }
      ],
      "fallback": [""]
    },
    {
      "id": "zhipu-glm",
      "match": { "contains_any": ["glm"] },
      "rules": [
        {
          "note": "GLM-5 served through DashScope exposes a reduced ladder.",
          "contains_any": ["glm-5"],
          "provider_any": ["dashscope"],
          "values": ["", "high", "max"]
        },
        {
          "contains_any": ["glm-5"],
          "values": ["", "low", "medium", "high", "xhigh", "max"]
        }
      ],
      "fallback": ["", "none", "high"]
    },
    {
      "id": "deepseek",
      "match": { "contains_any": ["deepseek"] },
      "rules": [
        {
          "contains_any": ["v4-pro", "v4_pro"],
          "values": ["", "high", "xhigh", "max"]
        },
        {
          "contains_any": ["v4", "deepseek-4"],
          "values": ["", "high", "max"]
        },
        {
          "note": "Reasoner / R1 always thinks.",
          "contains_any": ["reasoner", "-r1", "r1-"],
          "values": [""]
        }
      ],
      "fallback": ["", "none", "high"]
    },
    {
      "id": "alibaba-qwen",
      "match": { "contains_any": ["qwen", "qwq"] },
      "rules": [
        {
          "note": "QwQ always thinks.",
          "contains_any": ["qwq"],
          "values": [""]
        },
        {
          "contains_any": ["qwen3.8-max", "qwen3-8-max"],
          "values": ["", "low", "medium", "xhigh"]
        }
      ],
      "fallback": ["", "none", "high"]
    },
    {
      "id": "minimax",
      "match": { "contains_any": ["minimax", "abab"], "provider_any": ["minimax"] },
      "rules": [],
      "fallback": [""]
    },
    {
      "id": "perplexity-sonar",
      "match": { "contains_any": ["sonar"] },
      "rules": [
        {
          "note": "Deep Research is the only Sonar model with a reasoning_effort knob.",
          "contains_any": ["deep-research"],
          "values": ["", "low", "medium", "high"]
        }
      ],
      "fallback": [""]
    }
  ]
}
