// Builds the web frontend for the native shell and copies it into www/.
// Generated by Navin App Factory. The website itself is never modified:
// a Next.js export runs in a staging copy (.stage/), a client shell builds in web/.
import { spawnSync } from "node:child_process";
import {
  cpSync, existsSync, readFileSync, readdirSync, renameSync, rmSync, statSync, symlinkSync, writeFileSync,
} from "node:fs";
import { dirname, join, relative, resolve, sep } from "node:path";
import { fileURLToPath } from "node:url";

const here = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const cfg = JSON.parse(readFileSync(join(here, "appfactory.json"), "utf8"));
const site = resolve(here, cfg.frontend_dir);
const www = join(here, "www");
const env = { ...process.env };
for (const name of cfg.api_env || []) {
  if (cfg.backend_url && !env[name]) env[name] = cfg.backend_url;
}

function run(command, cwd) {
  console.log(`> ${command}   (in ${relative(here, cwd) || "."})`);
  const done = spawnSync(command, { cwd, env, stdio: "inherit", shell: true });
  if (done.status !== 0) {
    console.error(`build-web: failed: ${command}`);
    process.exit(done.status ?? 1);
  }
}

const pmExec = { pnpm: "pnpm exec", yarn: "yarn", bun: "bunx" }[cfg.package_manager] || "npx";
const SKIP_TOP = new Set(["node_modules", ".next", "out", ".git", "os", ".navin", "android", "ios", "src-tauri", ".turbo", ".vercel"]);

function stageNext() {
  const stage = join(here, ".stage");
  rmSync(stage, { recursive: true, force: true });
  cpSync(site, stage, {
    recursive: true,
    filter: (src) => {
      const rel = relative(site, src);
      if (!rel) return true;
      const parts = rel.split(sep);
      return !SKIP_TOP.has(parts[0]) && !parts.includes("node_modules");
    },
  });
  const modules = join(site, "node_modules");
  if (existsSync(modules)) symlinkSync(modules, join(stage, "node_modules"), process.platform === "win32" ? "junction" : "dir");
  else run(`${cfg.package_manager} install`, stage);
  let base = "";
  for (const name of readdirSync(stage)) {
    const found = /^next\.config\.(m?js|cjs|m?ts)$/.exec(name);
    if (!found) continue;
    renameSync(join(stage, name), join(stage, `next.config.base.${found[1]}`));
    base = found[1].endsWith("ts") ? "./next.config.base" : `./next.config.base.${found[1]}`;
  }
  const file = base.endsWith("base") ? "next.config.ts" : "next.config.mjs";
  const head = base ? `import base from "${base}";` : "const base = {};";
  // Turbopack follows the node_modules link only inside its root: the project root.
  const projectRoot = JSON.stringify(resolve(here, cfg.project_root || "../.."));
  writeFileSync(join(stage, file), `${head}
// Static export for the native app only: the website keeps its own next.config.
export default async function config(phase, ctx) {
  const resolved = typeof base === "function" ? await base(phase, ctx) : base;
  return {
    ...resolved,
    output: "export",
    trailingSlash: true,
    basePath: "",
    assetPrefix: "",
    images: { ...(resolved.images || {}), unoptimized: true },
    turbopack: { ...(resolved.turbopack || {}), root: ${projectRoot} },
  };
}
`);
  run(`${pmExec} next build`, stage);
  return join(stage, "out");
}

function buildSite() {
  if (!existsSync(join(site, "node_modules"))) run(`${cfg.package_manager} install`, site);
  const base = cfg.vite_base || "";
  const rebase = base.startsWith("/") && base !== "/" ? " -- --base=./" : "";
  const startedAt = Date.now();
  run(`${cfg.web_build_command}${rebase}`, site);
  const expected = resolve(site, cfg.output_dir);
  if (existsSync(join(expected, "index.html"))) return expected;
  // The build wrote somewhere else (an outDir computed in the config): take the
  // index.html the build just produced, searched near the site and the project root.
  const found = newestIndexHtml([site, resolve(here, cfg.project_root || "../..")], startedAt);
  if (found) {
    console.log(`build-web: output_dir ${cfg.output_dir} has no index.html; using ${relative(here, found)} (built just now)`);
    return found;
  }
  return expected;
}

const SKIP_SEARCH = new Set(["node_modules", ".git", "os", ".navin", "src", "public", "android", "ios", "src-tauri", ".stage", "www"]);

function newestIndexHtml(roots, since) {
  let best = null;
  const visit = (dir, depth) => {
    let entries;
    try { entries = readdirSync(dir, { withFileTypes: true }); } catch { return; }
    for (const entry of entries) {
      if (!entry.isDirectory() || SKIP_SEARCH.has(entry.name) || entry.name.startsWith(".")) continue;
      const path = join(dir, entry.name);
      const index = join(path, "index.html");
      if (existsSync(index)) {
        const mtime = statSync(index).mtimeMs;
        if (mtime >= since - 2000 && (!best || mtime > best.mtime)) best = { path, mtime };
      }
      if (depth < 4) visit(path, depth + 1);
    }
  };
  for (const root of roots) visit(root, 0);
  return best ? best.path : null;
}

function buildShell() {
  const web = join(here, "web");
  if (!existsSync(join(web, "node_modules"))) run(`${cfg.package_manager} install`, web);
  run(`${cfg.package_manager} run build`, web);
  return join(web, "dist");
}

const output = cfg.strategy === "client-shell" ? buildShell() : cfg.strategy === "next-export" ? stageNext() : buildSite();
if (!existsSync(join(output, "index.html"))) {
  console.error(`build-web: no index.html in ${output}: the native app needs static files`);
  process.exit(2);
}
rmSync(www, { recursive: true, force: true });
cpSync(output, www, { recursive: true });

// Native helpers (back button, safe areas) are added to the copy in www/ only.
const native = join(here, "native");
function htmlFiles(dir) {
  return readdirSync(dir).flatMap((name) => {
    const path = join(dir, name);
    if (statSync(path).isDirectory()) return htmlFiles(path);
    return name.endsWith(".html") ? [path] : [];
  });
}
if (existsSync(native)) {
  cpSync(native, join(www, "navin-native"), { recursive: true });
  for (const file of htmlFiles(www)) {
    let html = readFileSync(file, "utf8");
    const prefix = relative(dirname(file), www).split(sep).join("/");
    const root = prefix ? `${prefix}/` : "./";
    if (/<meta[^>]+name=["']viewport["'][^>]*>/i.test(html)) {
      html = html.replace(/(<meta[^>]+name=["']viewport["'][^>]*content=["'])([^"']*)/i, (all, start, content) =>
        content.includes("viewport-fit") ? all : `${start}${content}, viewport-fit=cover`);
    } else {
      html = html.replace(/<head([^>]*)>/i, `<head$1><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">`);
    }
    if (!html.includes("navin-native/native.js")) {
      const tags = `<link rel="stylesheet" href="${root}navin-native/native.css"><script src="${root}navin-native/native.js"></script>`;
      html = html.includes("</head>") ? html.replace("</head>", `${tags}</head>`) : tags + html;
    }
    writeFileSync(file, html);
  }
}
console.log(`build-web: www/ ready from ${relative(here, output)}`);
