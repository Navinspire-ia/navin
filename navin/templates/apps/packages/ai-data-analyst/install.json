  "install": {
    "steps": [
      {
        "id": "read-playbook",
        "run": "Read .navin/apps/ai-data-analyst/install.json first. Do not guess env or DB."
      },
      {
        "id": "env",
        "run": "Copy web/.env.template to .env and fill every required secret."
      },
      {
        "id": "node-deps",
        "run": "In each packages[].path folder: npm install."
      },
      {
        "id": "py-deps",
        "run": "python -m venv .venv && .venv/bin/pip install -r requirements.txt (or poetry / uv)."
      },
      {
        "id": "db-mysql",
        "run": "docker compose up -d mysql || docker run -d --name navin-mysql -e MYSQL_ROOT_PASSWORD=navin -e MYSQL_DATABASE=app -p 3306:3306 mysql:8"
      },
      {
        "id": "overlay",
        "run": "Customize .navin/apps/ai-data-analyst/overlay.json (agents, prompts, extra env)."
      },
      {
        "id": "dev",
        "run": "npm run dev"
      }
    ]
  },
  "modify": {
    "overlay": ".navin/apps/ai-data-analyst/overlay.json",
    "agents": ".navin/apps/ai-data-analyst/agents/",
    "env": ".env",
    "frontend": "web/package.json",
    "backend": "pyproject.toml",
    "theme": "Use packages/<slug>/patches when present. Do not rewrite the upstream repo.",
    "rule": "overlay.json wins over navin.json. Change prompts, tools and env there first."
  },
  "agents": {
    "universal": [
      "research-agent",
      "analytics-agent",
      "document-agent",
      "knowledge-agent",
      "automation-agent"
    ],
    "domain": [
      "sql-agent",
      "data-analyst-agent",
      "visualization-agent",
      "dashboard-agent",
      "report-generator"
    ]
  },
  "agent_contract": "Before any edit: read this file, copy env, start databases with Docker, install front and back packages, then change overlay.json. Do not invent connection strings or skip DB bootstrap."
