  "docker": {
    "compose": [],
    "services": [],
    "dockerfile": false,
    "note": "If compose is empty, start databases[].docker_image with the bootstrap command."
  },
  "launch": {
    "dev": "npm run dev",
    "migrate": "npm run prisma:migrate",
    "build": "npm run build"
  },
  "install": {
    "steps": [
      {
        "id": "read-playbook",
        "run": "Read .navin/apps/inventory/install.json first. Do not guess env or DB."
      },
      {
        "id": "env",
        "run": "Copy .env.example to .env and fill every required secret."
      },
      {
        "id": "node-deps",
        "run": "In each packages[].path folder: npm install."
      },
      {
        "id": "db-postgres",
        "run": "docker compose up -d postgres || docker run -d --name navin-postgres -e POSTGRES_PASSWORD=navin -e POSTGRES_USER=navin -e POSTGRES_DB=app -p 5432:5432 postgres:16-alpine | Wait for pg_isready, then run launch.migrate and launch.seed."
      },
      {
        "id": "db-mongodb",
        "run": "docker compose up -d mongo || docker run -d --name navin-mongo -p 27017:27017 mongo:7 | Set MONGODB_URI=mongodb://127.0.0.1:27017/app then start the API."
      },
      {
        "id": "migrate",
        "run": "npm run prisma:migrate"
      },
      {
        "id": "overlay",
        "run": "Customize .navin/apps/inventory/overlay.json (agents, prompts, extra env)."
      },
      {
        "id": "dev",
        "run": "npm run dev"
      }
    ]
  },
  "modify": {
    "overlay": ".navin/apps/inventory/overlay.json",
    "agents": ".navin/apps/inventory/agents/",
    "env": ".env",
    "frontend": "package.json",
    "backend": "package.json",
    "theme": "Use packages/<slug>/patches when present. Do not rewrite the upstream repo.",
    "rule": "overlay.json wins over navin.json. Change prompts, tools and env there first."
  },
  "agents": {
    "universal": [
      "research-agent",
      "analytics-agent",
      "document-agent",
      "knowledge-agent",
      "automation-agent"
    ],
    "domain": [
      "inventory-agent",
      "procurement-agent",
      "demand-forecast-agent",
      "warehouse-agent",
      "logistics-agent"
    ]
  },
  "agent_contract": "Before any edit: read this file, copy env, start databases with Docker, install front and back packages, then change overlay.json. Do not invent connection strings or skip DB bootstrap."
}
