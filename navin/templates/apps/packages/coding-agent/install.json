  "docker": {
    "compose": [
      "examples/acp-docker/docker-compose.yml"
    ],
    "services": [
      {
        "name": "agent-server",
        "image": "${AGENT_SERVER_IMAGE:-ghcr.io/openhands/agent-server:latest-python}",
        "ports": [
          "8010:8000"
        ]
      }
    ],
    "dockerfile": true,
    "note": "If compose is empty, start databases[].docker_image with the bootstrap command."
  },
  "launch": {
    "dev": "npm run dev",
    "build": "npm run build"
  },
  "install": {
    "steps": [
      {
        "id": "read-playbook",
        "run": "Read .navin/apps/coding-agent/install.json first. Do not guess env or DB."
      },
      {
        "id": "env",
        "run": "Copy .env.sample to .env and fill every required secret."
      },
      {
        "id": "node-deps",
        "run": "In each packages[].path folder: npm install."
      },
      {
        "id": "overlay",
        "run": "Customize .navin/apps/coding-agent/overlay.json (agents, prompts, extra env)."
      },
      {
        "id": "dev",
        "run": "npm run dev"
      }
    ]
  },
  "modify": {
    "overlay": ".navin/apps/coding-agent/overlay.json",
    "agents": ".navin/apps/coding-agent/agents/",
    "env": ".env",
    "frontend": "package.json",
    "backend": "package.json / pyproject of role=backend",
    "theme": "Use packages/<slug>/patches when present. Do not rewrite the upstream repo.",
    "rule": "overlay.json wins over navin.json. Change prompts, tools and env there first."
  },
  "agents": {
