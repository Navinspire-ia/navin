  "databases": [
    {
      "engine": "postgres",
      "required": true,
      "docker_image": "postgres:16-alpine",
      "port": 5432,
      "env_url": "DATABASE_URL",
      "compose": [],
      "bootstrap": [
        "docker compose up -d postgres || docker run -d --name navin-postgres -e POSTGRES_PASSWORD=navin -e POSTGRES_USER=navin -e POSTGRES_DB=app -p 5432:5432 postgres:16-alpine",
        "Wait for pg_isready, then run launch.migrate and launch.seed."
      ]
    }
  ],
  "ports": [
    3000,
    5432
  ],
  "env_files": [
    ".env.example"
  ],
  "env": [
    {
      "key": "POSTGRES_URL",
      "default": "postgresql://***",
      "required": false,
      "secret": false,
      "purpose": "Postgres connection string",
      "from": ".env.example"
    },
    {
      "key": "STRIPE_SECRET_KEY",
      "default": "sk_test_***",
      "required": true,
      "secret": true,
      "purpose": "Stripe secret key",
      "from": ".env.example"
    },
    {
      "key": "STRIPE_WEBHOOK_SECRET",
      "default": "whsec_***",
      "required": true,
      "secret": true,
      "purpose": "Stripe webhook secret",
      "from": ".env.example"
    },
    {
      "key": "BASE_URL",
      "default": "http://localhost:3000",
      "required": false,
      "secret": false,
      "purpose": "Service URL",
      "from": ".env.example"
    },
    {
      "key": "AUTH_SECRET",
      "default": "***",
      "required": true,
      "secret": true,
      "purpose": "Auth / secret",
      "from": ".env.example"
    },
    {
      "key": "DATABASE_URL",
      "default": "postgres://navin:navin@127.0.0.1:5432/app",
      "required": true,
      "secret": false,
      "purpose": "Postgres connection string",
      "from": "inferred"
