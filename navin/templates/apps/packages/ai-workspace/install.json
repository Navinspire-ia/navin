{
  "schema": "navin-app-install.v2",
  "slug": "ai-workspace",
  "name": "AI Workspace",
  "kind": "ai-product",
  "category": "chat",
  "source_github": "https://github.com/vercel/chatbot",
  "source_name": "Vercel Chatbot",
  "license": "Apache-2.0",
  "stack": [
    "Next.js",
    "React",
    "PostgreSQL"
  ],
  "studied_from": "templates_apps/ai-workspace",
  "completeness": {
    "studied": true,
    "missing": [],
    "env_count": 10,
    "package_count": 1
  },
  "docs": {
    "readme": "README.md",
    "extra": [],
    "summary": "Chatbot (formerly AI Chatbot) is a free, open-source template built with Next.js and the AI SDK that helps you quickly build powerful chatbot applications. Features - Advanced routing for seamless navigation and performance - React Server Components (RSCs) and Server Actions for server-side rendering and increased performance - Unified API for generating text, structured objects, and tool calls with LLMs - Hooks for building dynamic chat and generative user interfaces - Supports OpenAI, Anthropic, Google, xAI, and other model providers via AI Gateway"
  },
  "system": {
    "node": true,
    "node_engine": ">=18",
    "python": false,
    "docker": true,
    "package_manager": "pnpm",
    "make": false,
    "prisma": false,
    "supabase_cli": false
  },
  "tools": [
    {
      "id": "git",
      "why": "Clone / update the template source"
    },
    {
      "id": "pnpm",
      "why": "Install frontend / Node backend packages"
    },
    {
      "id": "node",
      "why": "Run Vite / Next / Express"
    },
    {
      "id": "docker",
      "why": "Run Postgres / Mongo / Redis / Supabase locally"
    }
  ],
  "packages": {
    "frontend": [
      {
        "role": "frontend",
        "path": "package.json",
        "name": "chatbot",
        "scripts": {
          "dev": "next dev --turbo",
          "build": "tsx lib/db/migrate && next build",
          "start": "next start",
          "db:generate": "drizzle-kit generate",
          "db:migrate": "npx tsx lib/db/migrate.ts",
          "db:studio": "drizzle-kit studio",
          "db:push": "drizzle-kit push",
          "db:pull": "drizzle-kit pull",
          "db:check": "drizzle-kit check",
          "db:up": "drizzle-kit up",
          "test": "export PLAYWRIGHT=True && pnpm exec playwright test"
        },
        "node_engine": "",
        "deps_hint": [
          "framer-motion",
          "next",
          "postgres",
          "react",
          "redis"
        ]
      }
    ],
    "backend": [],
    "all": [
      {
        "role": "frontend",
        "path": "package.json",
        "name": "chatbot",
        "scripts": {
          "dev": "next dev --turbo",
          "build": "tsx lib/db/migrate && next build",
          "start": "next start",
          "db:generate": "drizzle-kit generate",
          "db:migrate": "npx tsx lib/db/migrate.ts",
          "db:studio": "drizzle-kit studio",
          "db:push": "drizzle-kit push",
          "db:pull": "drizzle-kit pull",
          "db:check": "drizzle-kit check",
          "db:up": "drizzle-kit up",
          "test": "export PLAYWRIGHT=True && pnpm exec playwright test"
        },
        "node_engine": "",
        "deps_hint": [
          "framer-motion",
          "next",
          "postgres",
          "react",
          "redis"
        ]
      }
    ]
  },
  "databases": [
    {
      "engine": "postgres",
      "required": true,
      "docker_image": "postgres:16-alpine",
      "port": 5432,
      "env_url": "DATABASE_URL",
      "compose": [],
      "bootstrap": [
        "docker compose up -d postgres || docker run -d --name navin-postgres -e POSTGRES_PASSWORD=navin -e POSTGRES_USER=navin -e POSTGRES_DB=app -p 5432:5432 postgres:16-alpine",
        "Wait for pg_isready, then run launch.migrate and launch.seed."
      ]
    },
    {
      "engine": "redis",
      "required": false,
      "docker_image": "redis:7-alpine",
      "port": 6379,
      "env_url": "REDIS_URL",
      "compose": [],
      "bootstrap": [
        "docker compose up -d redis || docker run -d --name navin-redis -p 6379:6379 redis:7-alpine"
      ]
    }
  ],
  "ports": [
    5432,
    6379
  ],
  "env_files": [
    ".env.example"
  ],
  "env": [
    {
      "key": "AUTH_SECRET",
      "default": "****",
      "required": true,
      "secret": true,
      "purpose": "Auth / secret",
      "from": ".env.example"
    },
    {
      "key": "AI_GATEWAY_API_KEY",
      "default": "****",
      "required": true,
      "secret": true,
      "purpose": "",
      "from": ".env.example"
    },
    {
      "key": "BLOB_READ_WRITE_TOKEN",
      "default": "****",
      "required": true,
      "secret": true,
      "purpose": "Auth / secret",
      "from": ".env.example"
    },
    {
      "key": "POSTGRES_URL",
      "default": "****",
      "required": false,
      "secret": false,
      "purpose": "Postgres connection string",
      "from": ".env.example"
    },
    {
      "key": "REDIS_URL",
      "default": "****",
      "required": false,
      "secret": false,
      "purpose": "Redis connection string",
      "from": ".env.example"
    },
    {
      "key": "IS_DEMO",
      "default": "",
      "required": true,
      "secret": false,
      "purpose": "",
      "from": "source:next.config.ts"
    },
    {
      "key": "NEXT_PUBLIC_BASE_PATH",
      "default": "",
      "required": true,
      "secret": false,
      "purpose": "",
      "from": "source:proxy.ts"
    },
    {
      "key": "NODE_ENV",
      "default": "",
      "required": true,
      "secret": false,
      "purpose": "Node environment",
      "from": "source:components/chat/shell.tsx"
    },
    {
      "key": "PORT",
      "default": "",
      "required": true,
      "secret": false,
      "purpose": "HTTP port",
      "from": "source:playwright.config.ts"
    },
    {
      "key": "DATABASE_URL",
      "default": "postgres://navin:navin@127.0.0.1:5432/app",
      "required": true,
      "secret": false,
      "purpose": "Postgres connection string",
      "from": "inferred"
    }
  ],
  "docker": {
    "compose": [],
    "services": [],
    "dockerfile": false,
    "note": "If compose is empty, start databases[].docker_image with the bootstrap command."
  },
  "launch": {
    "dev": "npm run dev",
    "migrate": "npm run db:migrate",
    "build": "npm run build"
  },
  "install": {
    "steps": [
      {
        "id": "read-playbook",
        "run": "Read .navin/apps/ai-workspace/install.json first. Do not guess env or DB."
      },
      {
        "id": "env",
        "run": "Copy .env.example to .env and fill every required secret."
      },
      {
        "id": "node-deps",
        "run": "In each packages[].path folder: pnpm install."
      },
      {
        "id": "db-postgres",
        "run": "docker compose up -d postgres || docker run -d --name navin-postgres -e POSTGRES_PASSWORD=navin -e POSTGRES_USER=navin -e POSTGRES_DB=app -p 5432:5432 postgres:16-alpine | Wait for pg_isready, then run launch.migrate and launch.seed."
      },
      {
        "id": "migrate",
        "run": "npm run db:migrate"
      },
      {
        "id": "overlay",
        "run": "Customize .navin/apps/ai-workspace/overlay.json (agents, prompts, extra env)."
      },
      {
        "id": "dev",
        "run": "npm run dev"
      }
    ]
  },
  "modify": {
    "overlay": ".navin/apps/ai-workspace/overlay.json",
    "agents": ".navin/apps/ai-workspace/agents/",
    "env": ".env",
    "frontend": "package.json",
    "backend": "package.json / pyproject of role=backend",
    "theme": "Use packages/<slug>/patches when present. Do not rewrite the upstream repo.",
    "rule": "overlay.json wins over navin.json. Change prompts, tools and env there first."
  },
  "agents": {
    "universal": [
      "research-agent",
      "analytics-agent",
      "document-agent",
      "knowledge-agent",
      "automation-agent"
    ],
    "domain": [
      "general-assistant",
      "research-agent",
      "browser-agent",
      "document-agent",
      "coding-agent"
    ]
  },
  "agent_contract": "Before any edit: read this file, copy env, start databases with Docker, install front and back packages, then change overlay.json. Do not invent connection strings or skip DB bootstrap."
}
