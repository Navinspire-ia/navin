  "docker": {
    "compose": [
      "docker-compose.yml"
    ],
    "services": [
      {
        "name": "browser-use-webui",
        "image": "ghcr.io/browser-use/web-ui",
        "ports": [
          "7788:7788",
          "6080:6080",
          "5901:5901",
          "9222:9222"
        ]
      }
    ],
    "dockerfile": true,
    "note": "If compose is empty, start databases[].docker_image with the bootstrap command."
  },
  "launch": {
    "dev": "python -m uvicorn app:app --reload || python manage.py runserver"
  },
  "install": {
    "steps": [
      {
        "id": "read-playbook",
        "run": "Read .navin/apps/browser-agent/install.json first. Do not guess env or DB."
      },
      {
        "id": "env",
        "run": "Copy .env.example to .env and fill every required secret."
      },
      {
        "id": "py-deps",
        "run": "python -m venv .venv && .venv/bin/pip install -r requirements.txt (or poetry / uv)."
      },
      {
        "id": "overlay",
        "run": "Customize .navin/apps/browser-agent/overlay.json (agents, prompts, extra env)."
      },
      {
        "id": "dev",
        "run": "python -m uvicorn app:app --reload || python manage.py runserver"
      }
    ]
  },
  "modify": {
    "overlay": ".navin/apps/browser-agent/overlay.json",
    "agents": ".navin/apps/browser-agent/agents/",
    "env": ".env",
    "frontend": "package.json of role=frontend or root",
    "backend": "requirements.txt",
    "theme": "Use packages/<slug>/patches when present. Do not rewrite the upstream repo.",
    "rule": "overlay.json wins over navin.json. Change prompts, tools and env there first."
  },
  "agents": {
    "universal": [
      "research-agent",
      "analytics-agent",
      "document-agent",
      "knowledge-agent",
      "automation-agent"
    ],
    "domain": [
      "browser-agent",
      "form-agent",
      "extract-agent",
      "watch-agent",
      "report-agent"
    ]
  },
  "agent_contract": "Before any edit: read this file, copy env, start databases with Docker, install front and back packages, then change overlay.json. Do not invent connection strings or skip DB bootstrap."
