  "docker": {
    "compose": [],
    "services": [],
    "dockerfile": true,
    "note": "If compose is empty, start databases[].docker_image with the bootstrap command."
  },
  "launch": {
    "dev": "python -m uvicorn app:app --reload || python manage.py runserver"
  },
  "install": {
    "steps": [
      {
        "id": "read-playbook",
        "run": "Read .navin/apps/document-rag/install.json first. Do not guess env or DB."
      },
      {
        "id": "env",
        "run": "Copy .env.example to .env and fill every required secret."
      },
      {
        "id": "py-deps",
        "run": "python -m venv .venv && .venv/bin/pip install -r requirements.txt (or poetry / uv)."
      },
      {
        "id": "db-elasticsearch",
        "run": "Start via docker compose profile elasticsearch (do not invent a local sqlite file)."
      },
      {
        "id": "overlay",
        "run": "Customize .navin/apps/document-rag/overlay.json (agents, prompts, extra env)."
      },
      {
        "id": "dev",
        "run": "python -m uvicorn app:app --reload || python manage.py runserver"
      }
    ]
  },
  "modify": {
    "overlay": ".navin/apps/document-rag/overlay.json",
    "agents": ".navin/apps/document-rag/agents/",
    "env": ".env",
    "frontend": "package.json of role=frontend or root",
    "backend": "pyproject.toml",
    "theme": "Use packages/<slug>/patches when present. Do not rewrite the upstream repo.",
    "rule": "overlay.json wins over navin.json. Change prompts, tools and env there first."
