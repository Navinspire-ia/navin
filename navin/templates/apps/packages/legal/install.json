  "launch": {
    "dev": "npm run dev",
    "migrate": "npm run db:migrate",
    "build": "npm run build"
  },
  "install": {
    "steps": [
      {
        "id": "read-playbook",
        "run": "Read .navin/apps/legal/install.json first. Do not guess env or DB."
      },
      {
        "id": "env",
        "run": "Copy docker/.env.example to .env and fill every required secret."
      },
      {
        "id": "node-deps",
        "run": "In each packages[].path folder: pnpm install."
      },
      {
        "id": "db-postgres",
        "run": "docker compose up -d postgres || docker run -d --name navin-postgres -e POSTGRES_PASSWORD=navin -e POSTGRES_USER=navin -e POSTGRES_DB=app -p 5432:5432 postgres:16-alpine | Wait for pg_isready, then run launch.migrate and launch.seed."
      },
      {
        "id": "db-minio",
        "run": "Start MinIO via the project docker compose (object store for documents)."
      },
      {
        "id": "migrate",
        "run": "npm run db:migrate"
      },
      {
        "id": "overlay",
        "run": "Customize .navin/apps/legal/overlay.json (agents, prompts, extra env)."
      },
      {
        "id": "dev",
        "run": "npm run dev"
      }
    ]
  },
  "modify": {
    "overlay": ".navin/apps/legal/overlay.json",
    "agents": ".navin/apps/legal/agents/",
    "env": ".env",
    "frontend": "apps/web/package.json",
    "backend": "apps/api/package.json",
    "theme": "Use packages/<slug>/patches when present. Do not rewrite the upstream repo.",
    "rule": "overlay.json wins over navin.json. Change prompts, tools and env there first."
  },
  "agents": {
    "universal": [
      "research-agent",
      "analytics-agent",
      "document-agent",
      "knowledge-agent",
      "automation-agent"
    ],
    "domain": [
      "case-agent",
      "deadline-agent",
      "document-agent",
      "hearing-agent",
      "client-update-agent"
    ]
  },
  "agent_contract": "Before any edit: read this file, copy env, start databases with Docker, install front and back packages, then change overlay.json. Do not invent connection strings or skip DB bootstrap."
}
