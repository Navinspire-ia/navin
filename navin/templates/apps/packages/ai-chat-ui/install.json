  "install": {
    "steps": [
      {
        "id": "read-playbook",
        "run": "Read .navin/apps/ai-chat-ui/install.json first. Do not guess env or DB."
      },
      {
        "id": "env",
        "run": "Copy .env.template to .env and fill every required secret."
      },
      {
        "id": "node-deps",
        "run": "In each packages[].path folder: yarn."
      },
      {
        "id": "overlay",
        "run": "Customize .navin/apps/ai-chat-ui/overlay.json (agents, prompts, extra env)."
      },
      {
        "id": "dev",
        "run": "npm run dev"
      }
    ]
  },
