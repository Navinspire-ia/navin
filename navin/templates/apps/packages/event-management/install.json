  "install": {
    "steps": [
      {
        "id": "read-playbook",
        "run": "Read .navin/apps/event-management/install.json first. Do not guess env or DB."
      },
      {
        "id": "env",
        "run": "Copy .env.example to .env and fill every required secret."
      },
      {
        "id": "node-deps",
        "run": "In each packages[].path folder: bun install."
      },
      {
        "id": "db-mongodb",
        "run": "docker compose up -d mongo || docker run -d --name navin-mongo -p 27017:27017 mongo:7 | Set MONGODB_URI=mongodb://127.0.0.1:27017/app then start the API."
      },
      {
        "id": "overlay",
        "run": "Customize .navin/apps/event-management/overlay.json (agents, prompts, extra env)."
      },
      {
        "id": "dev",
        "run": "npm run dev"
      }
    ]
