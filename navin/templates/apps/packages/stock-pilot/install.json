      {
        "role": "frontend",
        "path": "frontend/package.json",
        "name": "StockPilot",
        "scripts": {
          "dev": "vite",
          "build": "vite build"
        },
        "node_engine": ">=18",
        "deps_hint": [
          "react",
          "vite"
        ]
      },
      {
        "role": "backend",
        "path": "backend/package.json",
        "name": "backend",
        "scripts": {
          "dev": "nodemon src/server.js",
          "start": "node src/server.js"
