  "docs": {
    "readme": "README.md",
    "extra": [],
    "summary": "StockPilot: React 19 + Vite frontend (:5173), Express 5 + Prisma + PostgreSQL backend (:5000), optional Redis and Next.js landing. JWT auth, POS, purchases, invoices, RBAC."
  },
  "system": {
    "node": true,
    "node_engine": ">=18",
    "python": false,
    "docker": true,
    "package_manager": "npm",
    "make": false,
    "prisma": true,
    "supabase_cli": false
  },
  "tools": [
    {
      "id": "git",
      "why": "Clone https://github.com/zacktam12/StockPilot"
    },
    {
      "id": "npm",
      "why": "Install frontend/ and backend/ separately"
    },
    {
      "id": "node",
      "why": "Node 18+ for Vite and Express"
    },
    {
      "id": "docker",
      "why": "Postgres 14+ and optional Redis"
    },
    {
      "id": "prisma",
      "why": "npx prisma generate / migrate deploy / db seed in backend/"
    }
  ],
  "packages": {
