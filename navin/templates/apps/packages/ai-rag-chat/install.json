  "docker": {
    "compose": [
      "docker/docker-compose.yml"
    ],
    "services": [
      {
        "name": "anything-llm",
        "image": "",
        "ports": []
      },
      {
        "name": "anything-llm",
        "image": "",
        "ports": [
          "3001:3001"
        ]
      }
    ],
    "dockerfile": true,
    "note": "If compose is empty, start databases[].docker_image with the bootstrap command."
  },
  "launch": {
    "dev": "npm run dev",
    "migrate": "npm run prisma:migrate",
    "seed": "npm run prisma:seed"
  },
  "install": {
    "steps": [
      {
        "id": "read-playbook",
        "run": "Read .navin/apps/ai-rag-chat/install.json first. Do not guess env or DB."
      },
      {
        "id": "env",
        "run": "Copy docker/.env.example to .env and fill every required secret."
      },
      {
        "id": "node-deps",
        "run": "In each packages[].path folder: npm install."
      },
      {
        "id": "db-postgres",
        "run": "docker compose up -d postgres || docker run -d --name navin-postgres -e POSTGRES_PASSWORD=navin -e POSTGRES_USER=navin -e POSTGRES_DB=app -p 5432:5432 postgres:16-alpine | Wait for pg_isready, then run launch.migrate and launch.seed."
      },
      {
        "id": "db-mysql",
        "run": "docker compose up -d mysql || docker run -d --name navin-mysql -e MYSQL_ROOT_PASSWORD=navin -e MYSQL_DATABASE=app -p 3306:3306 mysql:8"
      },
      {
        "id": "migrate",
        "run": "npm run prisma:migrate"
      },
      {
        "id": "seed",
        "run": "npm run prisma:seed"
      },
      {
        "id": "overlay",
        "run": "Customize .navin/apps/ai-rag-chat/overlay.json (agents, prompts, extra env)."
      },
      {
        "id": "dev",
        "run": "npm run dev"
      }
    ]
  },
  "modify": {
    "overlay": ".navin/apps/ai-rag-chat/overlay.json",
    "agents": ".navin/apps/ai-rag-chat/agents/",
    "env": ".env",
    "frontend": "frontend/package.json",
    "backend": "collector/package.json",
    "theme": "Use packages/<slug>/patches when present. Do not rewrite the upstream repo.",
    "rule": "overlay.json wins over navin.json. Change prompts, tools and env there first."
  },
  "agents": {
    "universal": [
      "research-agent",
      "analytics-agent",
      "document-agent",
      "knowledge-agent",
      "automation-agent"
    ],
    "domain": [
      "workspace-agent",
      "ingestion-agent",
      "rag-agent",
      "agent-builder",
      "connector-agent"
    ]
  },
  "agent_contract": "Before any edit: read this file, copy env, start databases with Docker, install front and back packages, then change overlay.json. Do not invent connection strings or skip DB bootstrap."
}
