  "docker": {
    "compose": [
      "docker/docker-compose.yml",
      "docker/docker-compose-base.yml"
    ],
    "services": [
      {
        "name": "mysql",
        "image": "mysql:8",
        "ports": [
          "3306:3306"
        ]
      },
      {
        "name": "es01",
        "image": "elasticsearch",
        "ports": [
          "9200:9200"
        ]
      },
      {
        "name": "redis",
        "image": "redis",
        "ports": [
          "6379:6379"
        ]
      },
      {
        "name": "minio",
        "image": "minio/minio",
        "ports": [
          "9000:9000"
        ]
      },
      {
        "name": "ragflow-cpu",
        "image": "infiniflow/ragflow",
        "ports": [
          "80:80",
          "9380:9380"
        ]
      }
    ],
    "dockerfile": true,
    "note": "Copy docker/.env.single-bucket-example to docker/.env then compose up. Do not use sqlite."
  },
  "launch": {
    "dev": "cd docker && docker compose --profile elasticsearch --profile cpu up -d",
    "build": "npm run build",
    "frontend": "cd web && npm run dev"
  },
  "install": {
    "steps": [
      {
        "id": "read-playbook",
        "run": "Read .navin/apps/rag-platform/install.json first. Do not guess env or DB."
      },
      {
        "id": "env",
        "run": "Copy agent/sandbox/.env.example to .env and fill every required secret."
      },
      {
        "id": "node-deps",
        "run": "In each packages[].path folder: npm install."
      },
      {
        "id": "py-deps",
        "run": "python -m venv .venv && .venv/bin/pip install -r requirements.txt (or poetry / uv)."
      },
      {
        "id": "db-postgres",
        "run": "docker compose up -d postgres || docker run -d --name navin-postgres -e POSTGRES_PASSWORD=navin -e POSTGRES_USER=navin -e POSTGRES_DB=app -p 5432:5432 postgres:16-alpine | Wait for pg_isready, then run launch.migrate and launch.seed."
      },
      {
        "id": "db-mysql",
        "run": "docker compose up -d mysql || docker run -d --name navin-mysql -e MYSQL_ROOT_PASSWORD=navin -e MYSQL_DATABASE=app -p 3306:3306 mysql:8"
      },
      {
        "id": "db-elasticsearch",
        "run": "Start via docker compose profile elasticsearch (do not invent a local sqlite file)."
      },
      {
        "id": "db-minio",
        "run": "Start MinIO via the project docker compose (object store for documents)."
      },
      {
        "id": "overlay",
        "run": "Customize .navin/apps/rag-platform/overlay.json (agents, prompts, extra env)."
      },
      {
        "id": "dev",
        "run": "npm run dev"
      }
    ]
  },
  "modify": {
    "overlay": ".navin/apps/rag-platform/overlay.json",
    "agents": ".navin/apps/rag-platform/agents/",
    "env": "docker/.env (from docker/.env.single-bucket-example)",
    "frontend": "web/package.json",
    "backend": "pyproject.toml",
    "theme": "Use packages/<slug>/patches when present. Do not rewrite the upstream repo.",
    "rule": "overlay.json wins over navin.json. Change prompts, tools and env there first."
  },
  "agents": {
    "universal": [
      "research-agent",
      "analytics-agent",
      "document-agent",
      "knowledge-agent",
      "automation-agent"
    ],
    "domain": [
      "knowledge-agent",
      "document-ingestion-agent",
      "research-agent",
      "qa-agent",
      "knowledge-curator"
    ]
  },
  "agent_contract": "Before any edit: read this file, copy env, start databases with Docker, install front and back packages, then change overlay.json. Do not invent connection strings or skip DB bootstrap."
}
