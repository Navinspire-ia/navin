# Live agent-loop corpus v1: each case replays realistic tool calls through
# the real AgentRunner in a fixture workspace and asserts real effects.
{"id": "bugfix-live-01", "category": "bugfix", "prompt": "Fix the off-by-one bug in calc.py: total() drops the last element.", "workspace": {"calc.py": "def total(xs):\n    return sum(xs[:len(xs)-1])\n"}, "script": [{"tool": "read_file", "args": {"path": "calc.py"}}, {"tool": "edit_file", "args": {"path": "calc.py", "old_text": "return sum(xs[:len(xs)-1])", "new_text": "return sum(xs)"}}, {"final": "Fixed the off-by-one: total() now sums every element."}], "expect": {"tools_ok": ["read_file", "edit_file"], "files_contain": {"calc.py": ["return sum(xs)"]}, "stop_reason": "completed", "final_contains": ["off-by-one"]}}
{"id": "feature-live-01", "category": "feature", "prompt": "Add a greet(name) helper in greet.py that returns 'Hello, <name>!'.", "workspace": {}, "script": [{"tool": "write_file", "args": {"path": "greet.py", "content": "def greet(name):\n    return f\"Hello, {name}!\"\n"}}, {"tool": "read_file", "args": {"path": "greet.py"}}, {"final": "Added greet() in greet.py."}], "expect": {"tools_ok": ["write_file", "read_file"], "files_contain": {"greet.py": ["def greet(name):", "Hello, {name}!"]}, "stop_reason": "completed"}}
{"id": "refactor-live-01", "category": "refactor", "prompt": "Rename compute() to calculate() in app.py and its caller.", "workspace": {"app.py": "def compute(x):\n    return x * 2\n\nprint(compute(3))\n"}, "script": [{"tool": "grep", "args": {"pattern": "compute", "path": ".", "output_mode": "content"}}, {"tool": "edit_file", "args": {"path": "app.py", "old_text": "def compute(x):", "new_text": "def calculate(x):"}}, {"tool": "edit_file", "args": {"path": "app.py", "old_text": "print(compute(3))", "new_text": "print(calculate(3))"}}, {"final": "Renamed compute to calculate everywhere."}], "expect": {"tools_ok": ["grep", "edit_file"], "files_contain": {"app.py": ["def calculate(x):", "print(calculate(3))"]}, "stop_reason": "completed"}}
{"id": "ask-live-01", "category": "read_only", "prompt": "Explain what util.py does. Do not edit anything.", "composer_mode": "ask", "workspace": {"util.py": "def double(x):\n    return x * 2\n"}, "script": [{"tool": "read_file", "args": {"path": "util.py"}}, {"tool": "write_file", "args": {"path": "notes.md", "content": "scratch"}}, {"final": "util.py exposes double(x), returning x * 2."}], "expect": {"tools_ok": ["read_file"], "tools_blocked": ["write_file"], "no_writes": true, "files_absent": ["notes.md"], "files_contain": {"util.py": ["return x * 2"]}, "stop_reason": "completed"}}
