      "cases": [
        {
          "id": "code-01",
          "split": "train",
          "prompt": "Fix the off-by-one bug in calc.py: total() must sum all the items.",
          "workspace": {
            "calc.py": "def total(xs):\n    return sum(xs[:-1])\n"
          },
          "script": [
            {"tool": "read_file", "args": {"path": "calc.py"}},
            {"tool": "edit_file", "args": {"path": "calc.py", "old_text": "return sum(xs[:-1])", "new_text": "return sum(xs)"}},
            {"final": "Fixed the off-by-one in calc.py: total() now sums every item."}
          ],
          "expect": {
            "tools_ok": ["read_file", "edit_file"],
            "files_contain": {"calc.py": ["return sum(xs)"]},
            "final_contains": ["Fixed"]
          }
        },
        {
          "id": "code-02",
          "split": "train",
          "prompt": "Add a helper slugify() to utils.py that lowercases a title and replaces spaces with dashes.",
          "workspace": {
