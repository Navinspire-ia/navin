# Réduit le contexte de build envoyé à Docker : seul `site/` est utile.
# Le Dockerfile est invoqué avec un contexte = racine du dépôt.

.git/2
.github/
.gitattributes
.gitignore
.dockerignore

# Artefacts de build de Next.js : regénérés par `next build` dans le stage builder.
site/.next/
site/node_modules/
site/out/
site/.turbo/
site/next-env.d.ts
site/tsconfig.tsbuildinfo

# Variables d'environnement locales : JAMAIS embarquées dans l'image.
.env
.env.*
!site/.env.example
site/.env
site/.env.local
site/.env.*.local

# Documentation / dev / build artefacts non utilisés par le runner.
docs/
*.md
!site/README.md
tests/
.omo/
.diagnostics/
.os/
os/
desktop/
templates/
webui/
navin/
scripts/
packaging/
bridge/
.hatch_build.py
pyproject.toml
uv.lock
poetry.lock
Makefile
docker-compose.yml
Dockerfile
*.log
logs/
tmp/
.DS_Store
__pycache__/
*.pyc

# Documents internes générés par les agents.
.navin/
.worktrees/
.worktree/